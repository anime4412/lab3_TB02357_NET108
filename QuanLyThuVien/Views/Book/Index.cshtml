@model IEnumerable<QuanLyThuVien.Models.Book>

@{
    ViewData["Title"] = "Quản lý sách thư viện - Lab 3";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary mb-0"><i class="bi bi-book"></i> Danh Mục Sách Thư Viện (BookDAL - Mô Hình 3 Lớp)</h2>
            <p class="text-muted small mb-0">Đề tài: Quản Lý Thư Viện Điện Tử | Môn: NET108 | Sinh viên: TB02357 - Nhóm 5</p>
        </div>
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Thêm Sách Mới</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning" role="alert">
            @ViewBag.Error
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 60px;">ID</th>
                            <th style="width: 140px;">ISBN</th>
                            <th>Tựa đề sách</th>
                            <th>Thể loại</th>
                            <th>Tác giả</th>
                            <th>NXB</th>
                            <th>Kệ</th>
                            <th class="text-end">Giá</th>
                            <th class="text-center">Số lượng</th>
                            <th style="width: 150px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>#@item.Id</strong></td>
                                    <td><code>@item.ISBN</code></td>
                                    <td class="fw-bold text-dark">@item.Title</td>
                                    <td><span class="badge bg-info text-dark">@(item.CategoryName ?? "Chưa phân loại")</span></td>
                                    <td>@(item.AuthorName ?? "N/A")</td>
                                    <td>@(item.PublisherName ?? "N/A")</td>
                                    <td><span class="badge bg-secondary">@(item.ShelfName ?? "Kho")</span></td>
                                    <td class="text-end text-danger fw-bold">@item.Price.ToString("N0") đ</td>
                                    <td class="text-center">
                                        <span class="badge bg-success">@item.AvailableQuantity / @item.Quantity</span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa cuốn sách này?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    Chưa có dữ liệu sách hoặc chưa kết nối đến CSDL SQL Server `QuanLyThuVien`.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
